{
  "name": "@comchatx/cx-listing-watch",
  "version": "0.1.5",
  "description": "Has cx check listings regularly and say what needs changing.",
  "license": "MIT",
  "author": "ComChatX",
  "comchatx": {
    "name": "Amazon Listing Watch",
    "about": "让 cx 按你的要求定期检查 listing，需要修改时再告诉你。",
    "mark": {
      "line": "review"
    },
    "section": "extensions",
    "order": 52,
    "needs": [
      "@comchatx/cx-schedule"
    ],
    "builds": [
      "@comchatx/cx-schedule",
      {
        "on": "cx-feishu",
        "need": "optional"
      },
      "cx-listing-playbook",
      "cx-amazon-sp-api",
      {
        "on": "cx-keepa",
        "need": "optional"
      }
    ],
    "prompts": {
      "listing-watch": {
        "zh": "告诉 cx 定期检查哪些 listing，以及何时告诉你。"
      }
    }
  },
  "homepage": "https://github.com/comchatx/cx-listing-watch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-listing-watch.git"
  },
  "bugs": "https://github.com/comchatx/cx-listing-watch/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "prompts",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
